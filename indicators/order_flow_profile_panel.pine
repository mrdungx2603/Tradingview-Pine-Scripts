//@version=6
// ─── Order Flow & Market Profile Panel ───
// Tác giả: TV Pine
// Ngày tạo: 2026-11-14
// Phiên bản: 1.0
// Mô tả: Pane riêng (không overlay) hiển thị 7 dòng dữ liệu, mỗi cột = 1 nến,
//        trôi đồng bộ theo chart chính: Delta (footprint), CVD, TPO Count
//        (trên/dưới POC), Day Type, Open Type, RF (Rotation Factor), RSI.
//        Day Type & Open Type mỗi dòng merge thành 1 box duy nhất kéo dài
//        suốt phiên (full D1). Delta/CVD dùng fallback 3 tầng khi
//        request.footprint() không có dữ liệu cho mã đang chạy (vd VN30F1!).
// Phase: 1/2 — file độc lập, không import/export, không sửa market_profile.pine.
indicator(title="Order Flow & Market Profile Panel", shorttitle="OF Panel v6", overlay=false, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// 1. INPUTS
// ============================================================================
grp_footprint = "Footprint"
ticks_per_row     = input.int(10, "Ticks mỗi dòng (ticks_per_row)", minval=1, group=grp_footprint)
va_pct            = input.float(70.0, "Value Area (%)", minval=50.0, maxval=90.0, step=1.0, group=grp_footprint)
imb_pct           = input.float(300.0, "Ngưỡng Imbalance (%)", minval=100.0, step=10.0, group=grp_footprint)
lower_tf_fallback = input.string("1S", "Khung Thời Gian Dự Phòng (Lower TF)", group=grp_footprint)

grp_display = "Hiển Thị"
n_bars_display = input.int(60, "Số Cột Hiển Thị (Rolling Window)", minval=20, maxval=90, group=grp_display)

grp_mp = "Market Profile"
grid_rows   = input.int(60, "Độ Phân Giải Lưới Giá TPO (grid_rows)", minval=20, maxval=120, group=grp_mp)
ib_bars_cnt = input.int(2, "Số Thanh Nến Tính Initial Balance", minval=1, maxval=12, group=grp_mp)

grp_rsi = "RSI"
rsi_len = input.int(14, "Chu Kỳ RSI", minval=1, group=grp_rsi)
rsi_src = input.source(close, "Nguồn RSI", group=grp_rsi)

// ============================================================================
// 2. RSI & HẰNG SỐ VỊ TRÍ DÒNG TRONG PANE
// ============================================================================
float rsi_val = ta.rsi(rsi_src, rsi_len)

// Mỗi dòng cao 1 đơn vị trục y; dòng trên cùng = Delta, dòng dưới cùng = RSI.
var int Y_DELTA    = 7
var int Y_CVD      = 6
var int Y_TPO      = 5
var int Y_DAYTYPE  = 4
var int Y_OPENTYPE = 3
var int Y_RF       = 2
var int Y_RSI      = 1

// ============================================================================
// 3. MÀU DAY TYPE & UDT OFProfile (PORT TỪ market_profile.pine)
// ============================================================================
c_dt_trend     = color.rgb(27, 77, 62)       // Trend Day: Dark Green
c_dt_dd        = color.rgb(74, 21, 75)       // Double Distribution: Dark Purple
c_dt_neutral   = color.rgb(183, 121, 31)     // Neutral Day: Muted Amber
c_dt_nontrend  = color.rgb(45, 55, 72)       // Nontrend Day: Charcoal Gray
c_dt_normal    = color.rgb(26, 54, 93)       // Normal / Normal Variation: Deep Navy

f_get_daytype_color(string dt) =>
    color res = c_dt_normal
    if str.contains(dt, "Double-Distribution")
        res := c_dt_dd
    else if str.contains(dt, "Trend Day") and not str.contains(dt, "Nontrend")
        res := c_dt_trend
    else if str.contains(dt, "Neutral")
        res := c_dt_neutral
    else if str.contains(dt, "Nontrend")
        res := c_dt_nontrend
    res

// Ngưỡng tối thiểu (số ô giá) để nhận diện dải Single Prints giữa phiên —
// hằng số nội bộ (không phải input, panel này không cần tuỳ biến giá trị này).
var int MIN_TAIL_TPO = 2

type OFProfile
    int    start_bar     = na
    float  open_price    = na
    float  close_price   = na
    float  sess_high     = na
    float  sess_low      = na
    float  prev_vah      = na
    float  prev_val      = na
    float  ib_high       = na
    float  ib_low        = na
    bool   ib_locked     = false
    int    bars_in_sess  = 0
    bool   ext_up_first  = false
    bool   ext_dn_first  = false
    float  poc           = na
    float  vah           = na
    float  val           = na
    int    rf_score      = 0
    int    tpo_above_poc = 0
    int    tpo_below_poc = 0
    bool   has_sp_mid    = false
    string day_type      = "Đang hình thành..."
    string open_type     = "Đang xác định..."

var OFProfile       prof      = OFProfile.new()
var array<float>    arr_highs = array.new<float>()
var array<float>    arr_lows  = array.new<float>()

// ============================================================================
// 4. RESET PHIÊN MỚI & CỘNG DỒN THEO NẾN (port dòng 203-294 market_profile.pine)
// ============================================================================
bool is_new_session = timeframe.change("D")

if is_new_session
    float last_vah = prof.vah
    float last_val = prof.val

    prof := OFProfile.new(
         start_bar    = bar_index,
         open_price   = open,
         close_price  = close,
         sess_high    = high,
         sess_low     = low,
         prev_vah     = last_vah,
         prev_val     = last_val,
         ib_high      = high,
         ib_low       = low,
         ib_locked    = false,
         bars_in_sess = 1,
         rf_score     = 0
     )
    array.clear(arr_highs)
    array.clear(arr_lows)
    array.push(arr_highs, high)
    array.push(arr_lows, low)
else
    if not na(prof.start_bar)
        prof.bars_in_sess += 1
        prof.close_price  := close
        prof.sess_high    := math.max(prof.sess_high, high)
        prof.sess_low     := math.min(prof.sess_low, low)
        array.push(arr_highs, high)
        array.push(arr_lows, low)

        if prof.bars_in_sess <= ib_bars_cnt
            prof.ib_high := math.max(prof.ib_high, high)
            prof.ib_low  := math.min(prof.ib_low, low)
            if prof.bars_in_sess == ib_bars_cnt
                prof.ib_locked := true
        else
            prof.ib_locked := true
            if not prof.ext_up_first and not prof.ext_dn_first
                if high > prof.ib_high
                    prof.ext_up_first := true
                else if low < prof.ib_low
                    prof.ext_dn_first := true

        int bar_rf = 0
        if high > high[1]
            bar_rf += 1
        else if high < high[1]
            bar_rf -= 1

        if low > low[1]
            bar_rf += 1
        else if low < low[1]
            bar_rf -= 1
        prof.rf_score += bar_rf

// ============================================================================
// 5. ĐỘNG CƠ TPO, POC, VALUE AREA, TPO COUNT, SINGLE PRINTS, DAY/OPEN TYPE
//    (port dòng 348-415, 418-434, 443-468, 522-557 market_profile.pine)
// ============================================================================
if not na(prof.start_bar) and array.size(arr_highs) > 0
    int num_bars = array.size(arr_highs)
    float s_range = prof.sess_high - prof.sess_low
    float step = math.max(syminfo.mintick, s_range / grid_rows)

    array<int> tpo_counts = array.new<int>(grid_rows, 0)
    int total_tpo_accum = 0

    for b = 0 to num_bars - 1
        float b_h = array.get(arr_highs, b)
        float b_l = array.get(arr_lows, b)
        for r = 0 to grid_rows - 1
            float row_low  = prof.sess_low + r * step
            float row_high = row_low + step
            if b_h >= row_low and b_l <= row_high
                array.set(tpo_counts, r, array.get(tpo_counts, r) + 1)
                total_tpo_accum += 1

    // 5.1. Point of Control (POC)
    int max_tpo = -1
    int poc_row = 0
    float mid_row = (grid_rows - 1) / 2.0

    for r = 0 to grid_rows - 1
        int cnt = array.get(tpo_counts, r)
        if cnt > max_tpo
            max_tpo := cnt
            poc_row := r
        else if cnt == max_tpo
            if math.abs(r - mid_row) < math.abs(poc_row - mid_row)
                poc_row := r

    prof.poc := prof.sess_low + (poc_row + 0.5) * step

    // 5.2. Value Area (VAH & VAL) — va_pct là % thô (0-100, dùng chung với
    // request.footprint() ở Task 3) nên phải chia 100 tại đây để ra tỷ lệ.
    int target_va_tpo = math.round(total_tpo_accum * (va_pct / 100.0))
    int current_va_tpo = array.get(tpo_counts, poc_row)
    int up_idx = poc_row
    int dn_idx = poc_row

    while current_va_tpo < target_va_tpo and (up_idx < grid_rows - 1 or dn_idx > 0)
        int up_tpo = up_idx < grid_rows - 1 ? array.get(tpo_counts, up_idx + 1) : -1
        int dn_tpo = dn_idx > 0 ? array.get(tpo_counts, dn_idx - 1) : -1

        if up_tpo >= dn_tpo and up_idx < grid_rows - 1
            up_idx += 1
            current_va_tpo += up_tpo
        else if dn_idx > 0
            dn_idx -= 1
            current_va_tpo += dn_tpo

    prof.vah := prof.sess_low + (up_idx + 1.0) * step
    prof.val := prof.sess_low + dn_idx * step

    // 5.3. TPO Count Above/Below POC
    int above_cnt = 0
    int below_cnt = 0
    for r = 0 to grid_rows - 1
        if r > poc_row
            above_cnt += array.get(tpo_counts, r)
        else if r < poc_row
            below_cnt += array.get(tpo_counts, r)

    prof.tpo_above_poc := above_cnt
    prof.tpo_below_poc := below_cnt

    // 5.4. Buy/Sell tail rows & Single Prints giữa phiên (cần cho has_sp_mid)
    int buy_tail_rows = 0
    if poc_row > 0
        for r = 0 to poc_row - 1
            if array.get(tpo_counts, r) == 1
                buy_tail_rows += 1
            else
                break

    int sell_tail_rows = 0
    if poc_row < grid_rows - 1
        for r = grid_rows - 1 to poc_row + 1
            if array.get(tpo_counts, r) == 1
                sell_tail_rows += 1
            else
                break

    int sp_start_row = -1
    int sp_end_row   = -1
    int low_bound    = math.max(buy_tail_rows + 2, int(grid_rows * 0.2))
    int high_bound   = math.min(grid_rows - 1 - sell_tail_rows - 2, int(grid_rows * 0.8))

    if high_bound > low_bound
        for r = low_bound to high_bound
            if array.get(tpo_counts, r) == 1
                if sp_start_row == -1
                    sp_start_row := r
                sp_end_row := r
            else if sp_start_row != -1
                if (sp_end_row - sp_start_row + 1) >= MIN_TAIL_TPO
                    break
                else
                    sp_start_row := -1
                    sp_end_row   := -1

    prof.has_sp_mid := sp_start_row != -1 and (sp_end_row - sp_start_row + 1) >= MIN_TAIL_TPO

    // 5.5. Phân loại Day Type & Open Type (port dòng 522-557)
    float ib_rng = math.max(syminfo.mintick, prof.ib_high - prof.ib_low)
    float ext_up = math.max(0.0, prof.sess_high - prof.ib_high)
    float ext_dn = math.max(0.0, prof.ib_low - prof.sess_low)
    float total_ratio = s_range / ib_rng

    bool is_ext_up = ext_up > ib_rng * 0.10
    bool is_ext_dn = ext_dn > ib_rng * 0.10

    if is_ext_up and is_ext_dn
        bool close_near_mid = math.abs(prof.close_price - (prof.sess_high + prof.sess_low) / 2.0) <= s_range * 0.25
        prof.day_type := close_near_mid ? "Neutral Day (Center)" : "Neutral Day (Extreme)"
    else if prof.has_sp_mid and total_ratio >= 1.5
        prof.day_type := "Double-Distribution Trend Day"
    else if total_ratio >= 2.0 and math.abs(prof.rf_score) >= 3
        prof.day_type := "Trend Day"
    else if total_ratio < 1.15 and num_bars > ib_bars_cnt and math.abs(prof.rf_score) <= 2
        prof.day_type := "Nontrend Day"
    else if total_ratio >= 1.25 and (is_ext_up or is_ext_dn)
        prof.day_type := "Normal Variation Day"
    else
        prof.day_type := "Normal Day"

    float open_pos_in_ib = (prof.open_price - prof.ib_low) / ib_rng
    bool open_out_of_va  = not na(prof.prev_vah) and (prof.open_price > prof.prev_vah or prof.open_price < prof.prev_val)

    if open_pos_in_ib <= 0.12 or open_pos_in_ib >= 0.88
        prof.open_type := "Open-Drive (OD)"
    else if (open_pos_in_ib <= 0.30 and is_ext_up and not is_ext_dn) or (open_pos_in_ib >= 0.70 and is_ext_dn and not is_ext_up)
        prof.open_type := "Open-Test-Drive (OTD)"
    else if (prof.ext_up_first and prof.close_price < (prof.ib_high + prof.ib_low) / 2.0) or (prof.ext_dn_first and prof.close_price > (prof.ib_high + prof.ib_low) / 2.0)
        prof.open_type := "Open-Rejection-Reverse (ORR)"
    else if open_out_of_va
        prof.open_type := "Open-Auction Out of Range (OAOR)"
    else
        prof.open_type := "Open-Auction In Range (OAIR)"

// ============================================================================
// 6. ENGINE DELTA/CVD — 3 TẦNG FALLBACK
// ============================================================================
// Tầng 1: request.footprint() — chính xác nhất, cần TradingView Premium/Ultimate
// và sàn hỗ trợ dữ liệu tick-level. Gọi KHÔNG điều kiện mỗi bar (Pine yêu cầu
// request.*() không được đặt trong if).
footprint fp = request.footprint(ticks_per_row, va_pct, imb_pct)

// Tầng 2: request.security_lower_tf() — xấp xỉ delta từ nến con khung nhỏ hơn.
// Cũng gọi không điều kiện mỗi bar.
array<float> ltf_close = request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, close)
array<float> ltf_open  = request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, open)
array<float> ltf_vol   = request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, volume)

float  delta        = na
string delta_source = na

if not na(fp)
    delta        := fp.delta()
    delta_source := "Footprint"
else if array.size(ltf_close) > 0
    float ltf_delta = 0.0
    for i = 0 to array.size(ltf_close) - 1
        float c = array.get(ltf_close, i)
        float o = array.get(ltf_open, i)
        float v = array.get(ltf_vol, i)
        if c > o
            ltf_delta += v
        else if c < o
            ltf_delta -= v
    delta        := ltf_delta
    delta_source := "LowerTF"
else
    // Tầng 3: xấp xỉ thuần OHLCV kiểu Chaikin — luôn có dữ liệu, không cần request thêm.
    float rng = high - low
    delta        := rng > 0 ? volume * ((close - low) - (high - close)) / rng : 0.0
    delta_source := "OHLCV-Approx"

// CVD — cộng dồn delta theo nến, reset về 0 khi phiên mới bắt đầu. Chỉ cộng dồn
// khi nến đã đóng (isconfirmed) để tránh CVD trôi theo các giá trị delta tạm
// (repaint) của nến đang chạy.
var float cvd = 0.0
if barstate.isconfirmed
    cvd := is_new_session ? delta : cvd + delta

// ============================================================================
// 7. RENDERER BOX-GRID — ROLLING WINDOW & BAND PHIÊN
// ============================================================================
f_push_cell(array<box> col_boxes, float y_top, float y_bottom, string txt, color bg, int max_cols) =>
    box b = box.new(bar_index - 0.5, y_top, bar_index + 0.5, y_bottom, border_color=bg, bgcolor=bg, text=txt, text_color=color.white, text_size=size.tiny)
    array.push(col_boxes, b)
    if array.size(col_boxes) > max_cols
        box.delete(array.shift(col_boxes))

var array<box> col_delta = array.new<box>()
var array<box> col_cvd   = array.new<box>()
var array<box> col_tpo   = array.new<box>()
var array<box> col_rf    = array.new<box>()
var array<box> col_rsi   = array.new<box>()

if barstate.isconfirmed
    // Màu dương=forest green, âm=burgundy, trung tính=gray (đồng bộ bảng màu market_profile.pine).
    color  c_delta    = delta > 0 ? color.rgb(27, 77, 62) : delta < 0 ? color.rgb(139, 0, 0) : color.gray
    color  c_cvd      = cvd > 0 ? color.rgb(27, 77, 62) : cvd < 0 ? color.rgb(139, 0, 0) : color.gray
    color  c_rf       = prof.rf_score > 0 ? color.rgb(27, 77, 62) : prof.rf_score < 0 ? color.rgb(139, 0, 0) : color.gray
    color  c_tpo      = prof.tpo_below_poc > prof.tpo_above_poc ? color.rgb(27, 77, 62) : prof.tpo_above_poc > prof.tpo_below_poc ? color.rgb(139, 0, 0) : color.gray
    color  c_rsi      = rsi_val > 70 ? color.rgb(139, 0, 0) : rsi_val < 30 ? color.rgb(27, 77, 62) : color.rgb(26, 54, 93)
    string delta_tag  = delta_source == "Footprint" ? "F" : delta_source == "LowerTF" ? "L" : "A"
    string delta_txt  = str.tostring(delta, format.volume) + " " + delta_tag

    f_push_cell(col_delta, Y_DELTA, Y_DELTA - 1, delta_txt, c_delta, n_bars_display)
    f_push_cell(col_cvd,   Y_CVD,   Y_CVD - 1,   str.tostring(cvd, format.volume), c_cvd, n_bars_display)
    f_push_cell(col_tpo,   Y_TPO,   Y_TPO - 1,   str.tostring(prof.tpo_above_poc) + "/" + str.tostring(prof.tpo_below_poc), c_tpo, n_bars_display)
    f_push_cell(col_rf,    Y_RF,    Y_RF - 1,    str.tostring(prof.rf_score), c_rf, n_bars_display)
    f_push_cell(col_rsi,   Y_RSI,   Y_RSI - 1,   str.tostring(rsi_val, "#.#"), c_rsi, n_bars_display)

// Band Day Type / Open Type — 1 box/dòng/phiên, trải từ đầu phiên tới nến
// hiện tại (merge full D1), cập nhật tại chỗ, không tạo mới mỗi bar.
var box b_daytype  = na
var box b_opentype = na

// Day Type dùng f_get_daytype_color() (tái dùng mapping màu market_profile.pine).
// Open Type dùng màu navy trung tính cố định (c_dt_normal), không phân loại theo hướng.
color c_daytype_now = f_get_daytype_color(prof.day_type)

if is_new_session
    box.delete(b_daytype)
    box.delete(b_opentype)
    b_daytype  := box.new(prof.start_bar, Y_DAYTYPE, bar_index, Y_DAYTYPE - 1, border_color=c_daytype_now, bgcolor=c_daytype_now, text=prof.day_type, text_color=color.white, text_size=size.small)
    b_opentype := box.new(prof.start_bar, Y_OPENTYPE, bar_index, Y_OPENTYPE - 1, border_color=c_dt_normal, bgcolor=c_dt_normal, text=prof.open_type, text_color=color.white, text_size=size.small)
else
    box.set_right(b_daytype, bar_index)
    box.set_text(b_daytype, prof.day_type)
    box.set_bgcolor(b_daytype, c_daytype_now)
    box.set_border_color(b_daytype, c_daytype_now)
    box.set_right(b_opentype, bar_index)
    box.set_text(b_opentype, prof.open_type)
