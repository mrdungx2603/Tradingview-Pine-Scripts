//@version=6
// ─── Order Flow & Market Profile Panel (Multi-Row Layout v2) ───
// Tác giả: TV Pine
// Ngày tạo: 2026-11-14
// Phiên bản: 2.0
// Mô tả: Pane riêng (không overlay) hiển thị order flow dạng grid với nhiều dòng
//        ngang, mỗi dòng = 1 metric (Time, Delta, CVD, TPO Count, RF, RSI).
//        Mỗi cột = 1 khung thời gian col_tf (gộp nến M1). Layout giống
//        TradingView Volume Footprint dashboard — mỗi ô vuông là 1 bar, chiều
//        cao mỗi dòng cố định. Delta hiển thị tổng, CVD/TPO/RF/RSI lấy mẫu
//        tích lũy-theo-phiên. Mỗi metric có toggle ẩn/hiện riêng. Neo theo
//        bar_index để khớp đúng vị trí nến trên chart.
// Changelog v2.0: **MAJOR REDESIGN: Multi-row layout (TradingView style)**
//        — mỗi metric là 1 dòng ngang cố định (y=0-1, y=1-2, ...). Mỗi cột =
//        1 khung col_tf (từ bar_index tới bar_index+1). Layout tạo grid giống
//        footprint dashboard. Scale pane neo theo tổng số dòng đang hiện. Backup
//        v1.12 tại indicators/hist/order_flow_profile_panel_v1.12.pine.

indicator(title="Order Flow & Market Profile Panel", shorttitle="OF Panel v2", overlay=false, max_boxes_count=500, max_labels_count=500, calc_bars_count=3000)

// ============================================================================
// 1. INPUTS — chia theo nhóm chức năng
// ============================================================================
grp_footprint     = "Footprint & Delta"
ticks_per_row     = input.int(10, "Ticks mỗi dòng (ticks_per_row)", minval=1, group=grp_footprint)
va_pct            = input.float(70.0, "Value Area (%)", minval=50.0, maxval=90.0, step=1.0, group=grp_footprint)
imb_pct           = input.float(300.0, "Ngưỡng Imbalance (%)", minval=100.0, step=10.0, group=grp_footprint)
lower_tf_fallback = input.string("1S", "Khung Thời Gian Dự Phòng (Lower TF)", group=grp_footprint)
show_delta_tag    = input.bool(true, "Hiện hậu tố nguồn Delta (F/L/A)", group=grp_footprint)

grp_mp    = "Market Profile & Khung Gộp Cột"
col_tf    = input.timeframe("5", "Khung Gộp Cột", group=grp_mp)
grid_rows = input.int(60, "Độ Phân Giải Lưới Giá TPO (grid_rows)", minval=20, maxval=120, group=grp_mp)

grp_rows  = "Hiện/Ẩn Dòng"
show_time  = input.bool(true, "Time", group=grp_rows)
show_delta = input.bool(true, "Delta", group=grp_rows)
show_cvd   = input.bool(true, "CVD", group=grp_rows)
show_tpo   = input.bool(true, "TPO Count", group=grp_rows)
show_rf    = input.bool(true, "RF", group=grp_rows)
show_rsi   = input.bool(true, "RSI", group=grp_rows)

grp_display    = "Hiển Thị (Giao Diện)"
n_bars_display = input.int(55, "Số Cột Hiển Thị", minval=10, maxval=55, group=grp_display)
font_choice    = input.string("Small", "Cỡ Chữ", options=["Tiny", "Small", "Normal", "Large"], group=grp_display)

grp_rsi = "RSI"
rsi_len = input.int(14, "Chu Kỳ RSI", minval=1, group=grp_rsi)
rsi_src = input.source(close, "Nguồn RSI", group=grp_rsi)

// ============================================================================
// 2. CỠ CHỮ & RSI THEO KHUNG col_tf
// ============================================================================
f_cell_size(string choice) =>
    string res = size.small
    if choice == "Tiny"
        res := size.tiny
    else if choice == "Normal"
        res := size.normal
    else if choice == "Large"
        res := size.large
    res

string cell_text_size = f_cell_size(font_choice)

float rsi_5m = na
if show_rsi
    rsi_5m := request.security(syminfo.tickerid, col_tf, ta.rsi(rsi_src, rsi_len))

// ============================================================================
// 3. VỊ TRÍ DÒNG ĐỘNG (mỗi dòng = 1 metric, Y từ 0 lên)
// ============================================================================
int y_cursor = 0
y_cursor := show_time  ? y_cursor + 1 : y_cursor
int Y_TIME = y_cursor
y_cursor := show_delta ? y_cursor + 1 : y_cursor
int Y_DELTA = y_cursor
y_cursor := show_cvd   ? y_cursor + 1 : y_cursor
int Y_CVD = y_cursor
y_cursor := show_tpo   ? y_cursor + 1 : y_cursor
int Y_TPO = y_cursor
y_cursor := show_rf    ? y_cursor + 1 : y_cursor
int Y_RF = y_cursor
y_cursor := show_rsi   ? y_cursor + 1 : y_cursor
int Y_RSI = y_cursor
int total_rows_visible = y_cursor

plot(0, title="Neo Scale Dưới", display=display.pane, color=color.new(color.white, 100))
plot(total_rows_visible, title="Neo Scale Trên", display=display.pane, color=color.new(color.white, 100))

// ============================================================================
// 4. MÀU SẮC
// ============================================================================
c_bull   = color.rgb(27, 77, 62)    // xanh buy
c_bear   = color.rgb(139, 0, 0)     // đỏ sell
c_neutral = color.gray
c_rsi_hot = color.rgb(139, 0, 0)    // RSI >70 đỏ
c_rsi_cold = color.rgb(27, 77, 62)  // RSI <30 xanh

// ============================================================================
// 5. UDT & RESET PHIÊN
// ============================================================================
type OFProfile
    int    start_bar     = na
    float  sess_high     = na
    float  sess_low      = na
    int    rf_score      = 0
    int    tpo_above_poc = 0
    int    tpo_below_poc = 0

var OFProfile prof = OFProfile.new()
var array<float> arr_highs = array.new<float>()
var array<float> arr_lows  = array.new<float>()

bool need_tpo_grid = show_tpo
bool need_rf       = show_rf
bool need_delta    = show_delta or show_cvd

bool is_new_session = timeframe.change("D")

if is_new_session
    prof := OFProfile.new(start_bar=bar_index, sess_high=high, sess_low=low, rf_score=0)
    array.clear(arr_highs)
    array.clear(arr_lows)
    array.push(arr_highs, high)
    array.push(arr_lows, low)
else
    if not na(prof.start_bar)
        prof.sess_high := math.max(prof.sess_high, high)
        prof.sess_low  := math.min(prof.sess_low, low)
        if need_tpo_grid
            array.push(arr_highs, high)
            array.push(arr_lows, low)
        if need_rf
            int bar_rf = 0
            if high > high[1]
                bar_rf += 1
            else if high < high[1]
                bar_rf -= 1
            if low > low[1]
                bar_rf += 1
            else if low < low[1]
                bar_rf -= 1
            prof.rf_score += bar_rf

// ============================================================================
// 6. TPO COUNT (chỉ tính trên/dưới POC)
// ============================================================================
if need_tpo_grid and not na(prof.start_bar) and array.size(arr_highs) > 0
    int num_bars = array.size(arr_highs)
    float s_range = prof.sess_high - prof.sess_low
    float step = math.max(syminfo.mintick, s_range / grid_rows)
    array<int> tpo_counts = array.new<int>(grid_rows, 0)

    for b = 0 to num_bars - 1
        float b_h = array.get(arr_highs, b)
        float b_l = array.get(arr_lows, b)
        for r = 0 to grid_rows - 1
            float row_low = prof.sess_low + r * step
            float row_high = row_low + step
            if b_h >= row_low and b_l <= row_high
                array.set(tpo_counts, r, array.get(tpo_counts, r) + 1)

    int poc_row = 0
    int max_tpo = -1
    float mid_row = (grid_rows - 1) / 2.0
    for r = 0 to grid_rows - 1
        int cnt = array.get(tpo_counts, r)
        if cnt > max_tpo
            max_tpo := cnt
            poc_row := r
        else if cnt == max_tpo
            if math.abs(r - mid_row) < math.abs(poc_row - mid_row)
                poc_row := r

    int above_cnt = 0
    int below_cnt = 0
    for r = 0 to grid_rows - 1
        if r > poc_row
            above_cnt += array.get(tpo_counts, r)
        else if r < poc_row
            below_cnt += array.get(tpo_counts, r)
    prof.tpo_above_poc := above_cnt
    prof.tpo_below_poc := below_cnt

// ============================================================================
// 7. DELTA/CVD — 3 TẦNG FALLBACK
// ============================================================================
float delta = na
string delta_source = na
var float cvd = 0.0

if need_delta
    footprint fp = request.footprint(ticks_per_row, va_pct, imb_pct)
    array<float> ltf_close = request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, close, ignore_invalid_timeframe=true)
    array<float> ltf_open  = request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, open, ignore_invalid_timeframe=true)
    array<float> ltf_vol   = request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, volume, ignore_invalid_timeframe=true)

    if not na(fp) and not na(fp.delta())
        delta := fp.delta()
        delta_source := "Footprint"
    else if array.size(ltf_close) > 0
        float ltf_delta = 0.0
        for i = 0 to array.size(ltf_close) - 1
            float c = array.get(ltf_close, i)
            float o = array.get(ltf_open, i)
            float v = array.get(ltf_vol, i)
            if c > o
                ltf_delta += v
            else if c < o
                ltf_delta -= v
        delta := ltf_delta
        delta_source := "LowerTF"
    else
        float rng = high - low
        delta := rng > 0 ? volume * ((close - low) - (high - close)) / rng : 0.0
        delta_source := "OHLCV-Approx"

    if barstate.isconfirmed
        cvd := is_new_session ? nz(delta) : cvd + nz(delta)

// ============================================================================
// 8. HELPER FUNCTIONS — FORMAT & RENDERER
// ============================================================================
f_format_delta(float val) =>
    string res = "0"
    float av = na(val) ? 0.0 : math.abs(val)
    string sign = (not na(val) and val < 0) ? "-" : ""
    if na(val)
        res := "0"
    else if av >= 1000000000
        res := sign + str.tostring(av / 1000000000, "#.##") + "B"
    else if av >= 1000000
        res := sign + str.tostring(av / 1000000, "#.##") + "M"
    else if av >= 1000
        res := sign + str.tostring(av / 1000, "#.##") + "K"
    else
        res := sign + str.tostring(av, "#")
    res

f_push_cell(array<box> col_boxes, float y_top, float y_bottom, string txt, color bg, int max_cols, int left_bar, int right_bar) =>
    box b = box.new(left_bar, y_top, right_bar + 1, y_bottom, border_color=bg, bgcolor=bg, text=txt, text_color=color.white, text_size=cell_text_size)
    array.push(col_boxes, b)
    if array.size(col_boxes) > max_cols
        box.delete(array.shift(col_boxes))

f_push_cell_time(array<box> col_boxes, float y_top, float y_bottom, string txt, color bg, int max_cols, int left_time, int right_time) =>
    box b = box.new(left_time, y_top, right_time, y_bottom, xloc=xloc.bar_time, border_color=bg, bgcolor=bg, text=txt, text_color=color.white, text_size=cell_text_size)
    array.push(col_boxes, b)
    if array.size(col_boxes) > max_cols
        box.delete(array.shift(col_boxes))

var array<box> col_time  = array.new<box>()
var array<box> col_delta = array.new<box>()
var array<box> col_cvd   = array.new<box>()
var array<box> col_tpo   = array.new<box>()
var array<box> col_rf    = array.new<box>()
var array<box> col_rsi   = array.new<box>()

// ============================================================================
// 9. GỘP CỘT col_tf & FLUSH
// ============================================================================
bool is_new_col = timeframe.change(col_tf)

float col_tf_num = str.tonumber(col_tf)
bool col_tf_is_min = not na(col_tf_num)
int col_tf_ms = col_tf_is_min ? int(col_tf_num * 60000) : na

var float bucket_delta_sum = 0.0
var float bucket_cvd_end = 0.0
var bool bucket_has_data = false
var int bucket_start_time = na
var int bucket_start_bar = na
var int bucket_last_bar = na

if barstate.isconfirmed
    if is_new_col
        color c_delta = bucket_delta_sum > 0 ? c_bull : bucket_delta_sum < 0 ? c_bear : c_neutral
        color c_cvd = bucket_cvd_end > 0 ? c_bull : bucket_cvd_end < 0 ? c_bear : c_neutral
        color c_rf = prof.rf_score > 0 ? c_bull : prof.rf_score < 0 ? c_bear : c_neutral
        color c_tpo = prof.tpo_below_poc > prof.tpo_above_poc ? c_bull : prof.tpo_above_poc > prof.tpo_below_poc ? c_bear : c_neutral
        color c_rsi = na(rsi_5m) ? c_neutral : rsi_5m > 70 ? c_rsi_hot : rsi_5m < 30 ? c_rsi_cold : color.rgb(26, 54, 93)

        string delta_tag = delta_source == "Footprint" ? "F" : delta_source == "LowerTF" ? "L" : "A"
        string delta_txt = f_format_delta(bucket_delta_sum) + (show_delta_tag ? " " + delta_tag : "")
        string time_txt = na(bucket_start_time) ? "—" : str.format_time(bucket_start_time, "HH:mm", syminfo.timezone)
        string cvd_txt = f_format_delta(bucket_cvd_end)
        string tpo_txt = str.tostring(prof.tpo_above_poc) + "/" + str.tostring(prof.tpo_below_poc)
        string rf_txt = str.tostring(prof.rf_score)
        string rsi_txt = na(rsi_5m) ? "—" : str.tostring(rsi_5m, "#.#")

        if bucket_has_data
            if show_time
                f_push_cell(col_time, Y_TIME, Y_TIME - 1, time_txt, c_neutral, n_bars_display, bucket_start_bar, bucket_last_bar)
            if show_delta
                f_push_cell(col_delta, Y_DELTA, Y_DELTA - 1, delta_txt, c_delta, n_bars_display, bucket_start_bar, bucket_last_bar)
            if show_cvd
                f_push_cell(col_cvd, Y_CVD, Y_CVD - 1, cvd_txt, c_cvd, n_bars_display, bucket_start_bar, bucket_last_bar)
            if show_tpo
                f_push_cell(col_tpo, Y_TPO, Y_TPO - 1, tpo_txt, c_tpo, n_bars_display, bucket_start_bar, bucket_last_bar)
            if show_rf
                f_push_cell(col_rf, Y_RF, Y_RF - 1, rf_txt, c_rf, n_bars_display, bucket_start_bar, bucket_last_bar)
            if show_rsi
                f_push_cell(col_rsi, Y_RSI, Y_RSI - 1, rsi_txt, c_rsi, n_bars_display, bucket_start_bar, bucket_last_bar)

        // LẤP GAP
        if col_tf_is_min and bucket_has_data and not na(bucket_start_time) and not is_new_session
            int bucket_end_expected = bucket_start_time + col_tf_ms
            int gap_ms = time - bucket_end_expected
            int gap_periods = gap_ms > col_tf_ms ? int(math.ceil(gap_ms / float(col_tf_ms))) : 0
            color c_gap = color.gray

            if gap_periods > 0
                for g = 0 to gap_periods - 1
                    int ph_start = bucket_end_expected + g * col_tf_ms
                    int ph_end = ph_start + col_tf_ms
                    string ph_time_txt = str.format_time(ph_start, "HH:mm", syminfo.timezone)

                    if show_time
                        f_push_cell_time(col_time, Y_TIME, Y_TIME - 1, ph_time_txt, c_gap, n_bars_display, ph_start, ph_end)
                    if show_delta
                        f_push_cell_time(col_delta, Y_DELTA, Y_DELTA - 1, "0", c_gap, n_bars_display, ph_start, ph_end)
                    if show_cvd
                        f_push_cell_time(col_cvd, Y_CVD, Y_CVD - 1, cvd_txt, c_gap, n_bars_display, ph_start, ph_end)
                    if show_tpo
                        f_push_cell_time(col_tpo, Y_TPO, Y_TPO - 1, tpo_txt, c_gap, n_bars_display, ph_start, ph_end)
                    if show_rf
                        f_push_cell_time(col_rf, Y_RF, Y_RF - 1, rf_txt, c_gap, n_bars_display, ph_start, ph_end)
                    if show_rsi
                        f_push_cell_time(col_rsi, Y_RSI, Y_RSI - 1, rsi_txt, c_gap, n_bars_display, ph_start, ph_end)

        bucket_delta_sum := nz(delta)
        bucket_cvd_end := cvd
        bucket_start_time := time
        bucket_start_bar := bar_index
        bucket_last_bar := bar_index
        bucket_has_data := true
    else
        bucket_delta_sum += nz(delta)
        bucket_cvd_end := cvd
        bucket_last_bar := bar_index

// ============================================================================
// 10. TÊN DÒNG — neo trục giá bên phải
// ============================================================================
plot(show_time  ? Y_TIME  : na, title="Time",      display=display.price_scale, color=color.gray)
plot(show_delta ? Y_DELTA : na, title="Delta",     display=display.price_scale, color=color.gray)
plot(show_cvd   ? Y_CVD   : na, title="CVD",       display=display.price_scale, color=color.gray)
plot(show_tpo   ? Y_TPO   : na, title="TPO Count", display=display.price_scale, color=color.gray)
plot(show_rf    ? Y_RF    : na, title="RF",        display=display.price_scale, color=color.gray)
plot(show_rsi   ? Y_RSI   : na, title="RSI",       display=display.price_scale, color=color.gray)
