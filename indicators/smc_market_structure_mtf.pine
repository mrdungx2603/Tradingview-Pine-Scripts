//@version=6
// ─── SMC Market Structure Indicator + Multi-Timeframe — Phân tích cấu trúc thị trường theo SMC ───
// Tác giả: TV Pine
// Ngày tạo: 2026-06-18
// Phiên bản: 2.1
// Mô tả: Mở rộng từ bản base, bổ sung bảng Multi-Timeframe hiển thị trend của 3 khung
//        thời gian khác nhau. Phát hiện cấu trúc xu hướng (HH/HL, LL/LH),
//        Break of Structure (BoS), Change of Character (CHoCH), Premium/Discount.
// Thay đổi v2.0: Viết lại hoàn toàn — dùng library smc_core + request.security() wrapper
//        chạy state machine SMC thật trên từng TF. Logic MTF chính xác (HH/HL/LH/LL).
// Thay đổi v2.1: Đổi import sang account anthonydang/smc_core/2 (gộp account, theo yêu cầu
//        người dùng — xem .claude/CLAUDE.md mục "Tài Khoản TradingView").
indicator(
    title="SMC Market Structure + MTF",
    shorttitle="SMC_STRUCTURE_MTF",
    overlay=true,
    max_lines_count=500,
    max_labels_count=500
)

// ─── Import Library ───
import anthonydang/smc_core/2 as smc

// ╔══════════════════════════════════════════╗
// ║              INPUTS                      ║
// ╚══════════════════════════════════════════╝

// ─── Seed Mode ───
seedMode = input.string(
    "Pivot Seed",
    "Seed Mode",
    options=["Pivot Seed", "Session Seed"],
    group="Tham Số Chính"
)

// ─── Pivot ───
pivotLength = input.int(
    5,
    "Pivot Length (cho Pivot Seed)",
    minval=2,
    maxval=50,
    group="Tham Số Chính"
)

// ─── BoS (Break of Structure) ───
show_bos      = input.bool(true, "Hiển Thị",                      group="BoS")
bos_title     = input.string("BoS", "Tiêu Đề Label",              group="BoS")
bos_style     = input.string("Solid", "Kiểu Đường",
    options=["Solid", "Dashed", "Dotted"],                        group="BoS")
bos_bull_color = input.color(color.blue,  "Màu Đường BoS Tăng",   group="BoS")
bos_bear_color = input.color(color.red,   "Màu Đường BoS Giảm",   group="BoS")

// ─── CHoCH (Change of Character) ───
show_choch   = input.bool(true, "Hiển Thị",                        group="CHoCH")
choch_title  = input.string("CHoCH", "Tiêu Đề Label",              group="CHoCH")
choch_style  = input.string("Dashed", "Kiểu Đường",
    options=["Solid", "Dashed", "Dotted"],                        group="CHoCH")
choch_color  = input.color(color.orange, "Màu Đường CHoCH",        group="CHoCH")

// ─── Label Cấu Trúc (HH/HL/LL/LH) ───
show_struct_labels = input.bool(true, "Hiển Thị",                  group="Label Cấu Trúc")
bullColor = input.color(color.blue,  "Màu Label Bull (HH/HL)",     group="Label Cấu Trúc")
bearColor = input.color(color.red,   "Màu Label Bear (LL/LH)",     group="Label Cấu Trúc")
show_temp_pivot = input.bool(true, "Hiển Thị Pivot Tạm (HL?/LH?)", group="Label Cấu Trúc")

// ─── Multi-Timeframe ───
show_mtf     = input.bool(true, "Hiển Thị",                        group="Multi-Timeframe")
mtf_tf1      = input.string("D",   "Khung TG 1",
    options=["1", "5", "15", "30", "60", "240", "D", "W", "M", "None"],
    group="Multi-Timeframe")
mtf_tf2      = input.string("240", "Khung TG 2",
    options=["1", "5", "15", "30", "60", "240", "D", "W", "M", "None"],
    group="Multi-Timeframe")
mtf_tf3      = input.string("60",  "Khung TG 3",
    options=["1", "5", "15", "30", "60", "240", "D", "W", "M", "None"],
    group="Multi-Timeframe")
mtf_pos      = input.string("Bottom Right", "Vị Trí",
    options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"],
    group="Multi-Timeframe")

// ─── Dashboard ───
show_dashboard = input.bool(true, "Hiển Thị",                      group="Dashboard")
dashboard_pos = input.string("Top Right", "Vị Trí",
    options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"],
    group="Dashboard")

// ╔══════════════════════════════════════════╗
// ║   BIẾN TRẠNG THÁI — MAIN CHART          ║
// ╚══════════════════════════════════════════╝

var smc.SwingState st = smc.f_init_state()

// ─── Temp Pivot Label ───
var label temp_pivot_label = na

// Quản lý phiên
is_new_session = timeframe.isminutes and session.isfirstbar_regular

// ╔══════════════════════════════════════════╗
// ║      TIMEFRAME CHECK & RESET             ║
// ╚══════════════════════════════════════════╝

if seedMode == "Session Seed" and not timeframe.isminutes
    runtime.error("Session Seed chỉ áp dụng cho khung thời gian phút (< 1 giờ)!")

if seedMode == "Session Seed" and is_new_session
    st := smc.f_init_state()

// ╔══════════════════════════════════════════╗
// ║           SEEDING LOGIC                  ║
// ╚══════════════════════════════════════════╝

if not st.seeded
    if seedMode == "Pivot Seed"
        ph = ta.pivothigh(pivotLength, pivotLength)
        pl = ta.pivotlow(pivotLength, pivotLength)
        st := smc.f_seed_pivot(st, ph, pl, pivotLength)

    else if seedMode == "Session Seed"
        st := smc.f_seed_session(st)

// ╔══════════════════════════════════════════╗
// ║        HÀM HELPER — VẼ ĐỒ HỌA           ║
// ╚══════════════════════════════════════════╝

// Resolve kiểu đường
line_style_bos   = smc.f_get_line_style(bos_style)
line_style_choch = smc.f_get_line_style(choch_style)

// ─── Vẽ Break of Structure (BoS) ───
plot_bos(int start_b, int end_b, float lvl, color col) =>
    if show_bos
        line.new(
            x1=start_b, y1=lvl,
            x2=end_b,   y2=lvl,
            xloc=xloc.bar_index,
            style=line_style_bos,
            color=col,
            width=1
        )
        label.new(
            x=math.round((start_b + end_b) / 2),
            y=lvl,
            text=bos_title,
            xloc=xloc.bar_index,
            textcolor=col,
            style=label.style_none,
            size=size.small
        )

// ─── Vẽ Change of Character (CHoCH) ───
plot_choch(int start_b, int end_b, float lvl, color col) =>
    if show_choch
        line.new(
            x1=start_b, y1=lvl,
            x2=end_b,   y2=lvl,
            xloc=xloc.bar_index,
            style=line_style_choch,
            color=col,
            width=1
        )
        label.new(
            x=math.round((start_b + end_b) / 2),
            y=lvl,
            text=choch_title,
            xloc=xloc.bar_index,
            textcolor=col,
            style=label.style_none,
            size=size.small
        )

// ─── Vẽ Label cho HH/HL/LL/LH ───
plot_label(int b_idx, string txt, color col, bool is_up) =>
    if show_struct_labels
        label.new(
            x=b_idx,
            y=is_up ? low[bar_index - b_idx] : high[bar_index - b_idx],
            text=txt,
            color=col,
            textcolor=color.white,
            style=is_up ? label.style_label_up : label.style_label_down,
            size=size.small
        )

// ╔══════════════════════════════════════════╗
// ║  STATE MACHINE — MAIN CHART             ║
// ╚══════════════════════════════════════════╝

if st.seeded
    // Lưu state cũ để detect sự kiện
    smc.SwingState old_st = st

    // Chạy state machine qua library
    st := smc.f_process_bar(st)

    // ─── Vẽ BoS/CHoCH dựa trên event ───
    if st.event == 1
        // BoS Bull
        plot_bos(old_st.hh_bar, bar_index, old_st.hh_price, bos_bull_color)

    else if st.event == -1
        // BoS Bear
        plot_bos(old_st.ll_bar, bar_index, old_st.ll_price, bos_bear_color)

    else if st.event == 2
        // CHoCH Bear
        plot_choch(old_st.hl_bar, bar_index, old_st.hl_price, choch_color)

    else if st.event == -2
        // CHoCH Bull
        plot_choch(old_st.lh_bar, bar_index, old_st.lh_price, choch_color)

    // ─── Phát hiện swing vừa được xác nhận (cand_type non-0 → 0) ───
    if old_st.cand_type != 0 and st.cand_type == 0
        if old_st.cand_type == 1
            // HH vừa được xác nhận — vẽ HH và HL
            plot_label(st.hh_bar, "HH", bullColor, false)
            plot_label(st.hl_bar, "HL", bullColor, true)
        else if old_st.cand_type == -1
            // LL vừa được xác nhận — vẽ LL và LH
            plot_label(st.ll_bar, "LL", bearColor, true)
            plot_label(st.lh_bar, "LH", bearColor, false)

// ╔══════════════════════════════════════════╗
// ║     TEMP PIVOT — HIỂN THỊ PIVOT TẠM THỜI ║
// ╚══════════════════════════════════════════╝

// Xóa temp label cũ mỗi bar để vẽ lại
if not na(temp_pivot_label)
    label.delete(temp_pivot_label)
    temp_pivot_label := na

// Vẽ temp pivot nếu đang trong quá trình săn (cand_type != 0)
if show_temp_pivot and show_struct_labels and st.cand_type != 0 and st.seeded
    bool is_hunting_high = (st.cand_type == 1)

    int scan_start = st.trigger_bar
    int scan_end   = st.cand_bar

    if not na(scan_start) and not na(scan_end) and scan_start <= scan_end
        // Dùng library f_find_extreme — loại trừ scan_end (chính cand_bar)
        // is_hunting_high=true → HL? (tìm lowest low), false → LH? (tìm highest high)
        [best_bar, best_price] = smc.f_find_extreme(scan_start, scan_end, scan_end, not is_hunting_high)

        temp_pivot_label := label.new(
            x=best_bar,
            y=best_price,
            text=is_hunting_high ? "HL?" : "LH?",
            color=color.new(color.gray, 30),
            textcolor=color.gray,
            style=is_hunting_high ? label.style_label_up : label.style_label_down,
            size=size.tiny
        )

// ╔══════════════════════════════════════════╗
// ║  MULTI-TIMEFRAME — STATE MACHINE THẬT    ║
// ╚══════════════════════════════════════════╝
//
// Wrapper pattern: f_run_smc() chạy bên trong request.security(),
// tạo execution context riêng trên TF đích với var state độc lập.
// bar_index, high, low, close bên trong wrapper thuộc về TF đích.
// State machine chạy chính xác trên từng TF, không phải pivot score.

// ─── Wrapper chạy SMC state machine trong 1 TF ───
f_run_smc(int pivot_len, string seed_mode) =>
    var smc.SwingState s = smc.f_init_state()

    if not s.seeded
        if seed_mode == "Pivot Seed"
            ph = ta.pivothigh(high, pivot_len, pivot_len)
            pl = ta.pivotlow(low, pivot_len, pivot_len)
            s := smc.f_seed_pivot(s, ph, pl, pivot_len)
        else
            s := smc.f_seed_session(s)

    if s.seeded
        s := smc.f_process_bar(s)
    s

// ─── Gọi wrapper cho từng TF qua request.security ───
smc.SwingState mtf_s1 = smc.f_init_state()
smc.SwingState mtf_s2 = smc.f_init_state()
smc.SwingState mtf_s3 = smc.f_init_state()

if show_mtf
    if mtf_tf1 != "None"
        mtf_s1 := request.security(syminfo.tickerid, mtf_tf1,
            f_run_smc(pivotLength, seedMode),
            lookahead=barmerge.lookahead_off)

    if mtf_tf2 != "None"
        mtf_s2 := request.security(syminfo.tickerid, mtf_tf2,
            f_run_smc(pivotLength, seedMode),
            lookahead=barmerge.lookahead_off)

    if mtf_tf3 != "None"
        mtf_s3 := request.security(syminfo.tickerid, mtf_tf3,
            f_run_smc(pivotLength, seedMode),
            lookahead=barmerge.lookahead_off)

// ╔══════════════════════════════════════════╗
// ║        HELPER — MTF DISPLAY              ║
// ╚══════════════════════════════════════════╝

// ─── Đổi mã TF sang tên hiển thị ───
f_tf_label(string tf_id) =>
    switch tf_id
        "1"   => "1m"
        "5"   => "5m"
        "15"  => "15m"
        "30"  => "30m"
        "60"  => "1H"
        "240" => "4H"
        "D"   => "D1"
        "W"   => "W1"
        "M"   => "MN"
        => ""

// ─── Trend → text ───
f_trend_text(int t) =>
    switch t
        1  => "BULL"
        -1 => "BEAR"
        => "WAIT"

// ─── Trend → màu ───
f_trend_color(int t) =>
    switch t
        1  => bullColor
        -1 => bearColor
        => color.gray

// ─── Lấy swing high/low theo trend SMC ───
f_swing_high(smc.SwingState s) =>
    s.trend == 1 ? s.hh_price : s.lh_price

f_swing_low(smc.SwingState s) =>
    s.trend == 1 ? s.hl_price : s.ll_price

// ─── Label cấu trúc swing (HH/HL hoặc LH/LL) ───
f_swing_label(int trend_val) =>
    trend_val == 1 ? "HH/HL" : trend_val == -1 ? "LH/LL" : "PH/PL"

// ╔══════════════════════════════════════════╗
// ║     BẢNG THỐNG KÊ CẤU TRÚC SMC          ║
// ╚══════════════════════════════════════════╝

var table smc_table = table.new(
    smc.f_get_dashboard_pos(dashboard_pos),
    columns=2,
    rows=4,
    bgcolor=color.new(color.black, 30),
    border_width=1,
    border_color=color.gray
)

if show_dashboard and barstate.islast
    // Xác định biên Swing hiện tại
    float swing_high_val = (st.trend == 1) ? st.hh_price : st.lh_price
    float swing_low_val  = (st.trend == 1) ? st.hl_price : st.ll_price

    // Tính toán % vị trí giá hiện tại (Premium/Discount)
    float range_diff_val = swing_high_val - swing_low_val
    float pos_pct_raw_val = (range_diff_val != 0) ? ((close - swing_low_val) / range_diff_val) * 100 : 0
    float pos_pct_val = (st.trend == 1) ? (100 - pos_pct_raw_val) : pos_pct_raw_val

    // Nội dung hiển thị
    string row1_col1 = (st.trend == 1) ? "HH Price" : "LH Price"
    string row1_col2 = str.tostring(
        (st.trend == 1) ? st.hh_price : st.lh_price,
        format.mintick
    )

    string row2_col1 = (st.trend == 1) ? "HL Price" : "LL Price"
    string row2_col2 = str.tostring(
        (st.trend == 1) ? st.hl_price : st.ll_price,
        format.mintick
    )

    string row3_col1 = "Vị trí trong Swing"
    string row3_col2 = str.tostring(pos_pct_val, "#.##") + "%"

    // Fill bảng
    table.cell(smc_table, 0, 0, "THÔNG SỐ SMC",
        text_color=color.white, text_size=size.small, bgcolor=color.gray)
    table.cell(smc_table, 1, 0, (st.trend == 1 ? "BULLISH" : "BEARISH"),
        text_color=color.white, text_size=size.small,
        bgcolor=(st.trend == 1 ? bullColor : bearColor))

    table.cell(smc_table, 0, 1, row1_col1,
        text_color=color.white, text_size=size.small)
    table.cell(smc_table, 1, 1, row1_col2,
        text_color=color.white, text_size=size.small)

    table.cell(smc_table, 0, 2, row2_col1,
        text_color=color.white, text_size=size.small)
    table.cell(smc_table, 1, 2, row2_col2,
        text_color=color.white, text_size=size.small)

    color pos_color_val = (st.trend == 1) ? (pos_pct_val > 50 ? color.green : color.red)
                                        : (pos_pct_val > 50 ? color.red   : color.green)

    table.cell(smc_table, 0, 3, row3_col1,
        text_color=color.white, text_size=size.small)
    table.cell(smc_table, 1, 3, row3_col2,
        text_color=pos_color_val,
        text_size=size.small)

// ╔══════════════════════════════════════════╗
// ║     BẢNG MULTI-TIMEFRAME TREND          ║
// ╚══════════════════════════════════════════╝

// Đếm số TF active
f_count_active() =>
    int cnt = 0
    if mtf_tf1 != "None"
        cnt += 1
    if mtf_tf2 != "None"
        cnt += 1
    if mtf_tf3 != "None"
        cnt += 1
    cnt

var table mtf_table = table.new(
    smc.f_get_dashboard_pos(mtf_pos),
    columns=4,
    rows=4,
    bgcolor=color.new(color.black, 30),
    border_width=1,
    border_color=color.gray
)

if show_mtf and barstate.islast
    int n_active = f_count_active()

    if n_active > 0
        // ─── Hàng 0: Tiêu đề bảng ───
        table.cell(mtf_table, 0, 0, "MTF TREND",
            text_color=color.white, text_size=size.small, bgcolor=color.gray)
        table.cell(mtf_table, 1, 0, "Trend",
            text_color=color.white, text_size=size.small, bgcolor=color.gray)
        table.cell(mtf_table, 2, 0, "Cấu Trúc",
            text_color=color.white, text_size=size.small, bgcolor=color.gray)
        table.cell(mtf_table, 3, 0, "Swing High / Swing Low",
            text_color=color.white, text_size=size.small, bgcolor=color.gray)

        // ─── Gom các TF active ───
        // Sử dụng array để lặp qua
        smc.SwingState[] mtf_states = array.from(mtf_s1, mtf_s2, mtf_s3)
        string[] mtf_ids = array.from(mtf_tf1, mtf_tf2, mtf_tf3)

        int row = 0
        for i = 0 to 2
            // Khai báo tất cả biến trong scope for trước khi dùng
            bool    tf_active   = mtf_ids.get(i) != "None"
            string  tf_label_txt  = tf_active ? f_tf_label(mtf_ids.get(i)) : ""
            int     tf_trend    = tf_active ? mtf_states.get(i).trend : 0
            color   tf_trend_clr = f_trend_color(tf_trend)
            string  tf_trend_txt = f_trend_text(tf_trend)
            string  tf_sw_label  = f_swing_label(tf_trend)
            float   tf_sh       = tf_active ? f_swing_high(mtf_states.get(i)) : na
            float   tf_sl       = tf_active ? f_swing_low(mtf_states.get(i)) : na

            string tf_sh_str = na(tf_sh) ? "-" : str.tostring(tf_sh, format.mintick)
            string tf_sl_str = na(tf_sl) ? "-" : str.tostring(tf_sl, format.mintick)
            string tf_sw_str = tf_sh_str + " / " + tf_sl_str

            if tf_active
                row += 1

                // Cột 0: Tên TF
                table.cell(mtf_table, 0, row, tf_label_txt,
                    text_color=color.white, text_size=size.small,
                    bgcolor=color.new(color.gray, 50))

                // Cột 1: Trend
                table.cell(mtf_table, 1, row, tf_trend_txt,
                    text_color=color.white, text_size=size.small,
                    bgcolor=tf_trend_clr)

                // Cột 2: Cấu trúc (HH/HL hoặc LH/LL)
                table.cell(mtf_table, 2, row, tf_sw_label,
                    text_color=color.white, text_size=size.small)

                // Cột 3: Swing High / Swing Low
                table.cell(mtf_table, 3, row, tf_sw_str,
                    text_color=color.white, text_size=size.small)

        // ─── Xoá các dòng thừa (nếu TF bị bỏ chọn) ───
        if n_active < 3
            for r = n_active + 1 to 3
                table.cell(mtf_table, 0, r, "",
                    text_color=color.white, text_size=size.small)
                table.cell(mtf_table, 1, r, "",
                    text_color=color.white, text_size=size.small)
                table.cell(mtf_table, 2, r, "",
                    text_color=color.white, text_size=size.small)
                table.cell(mtf_table, 3, r, "",
                    text_color=color.white, text_size=size.small)
