//@version=6
// ─── Order Flow Overlay (Phân Kỳ CVD, Delta Peak, RF, RSI) ───
// Phiên bản: 1.0
// Mô tả: Overlay lên nến chart. Đánh dấu phân kỳ CVD và RSI theo pivot, Delta Peak
//        (Delta vượt ngưỡng độ lệch chuẩn), RF mạnh (±2 trên nến) và bảng số liệu.
//        Mỗi đối tượng có công tắc hiển thị riêng. Chi tiết xem docs/order-flow-overlay.md.
indicator(title="Order Flow Overlay", shorttitle="OF Overlay", overlay=true, max_labels_count=500, max_lines_count=500)

// ============================================================================
// 1. INPUTS
// ============================================================================
grp_show = "Hiện/Ẩn Đối Tượng"
show_cvd_div    = input.bool(true, "Phân kỳ CVD", group=grp_show)
show_delta_peak = input.bool(true, "Delta Peak", group=grp_show)
show_rf_marks   = input.bool(true, "RF mạnh (±2 trên nến)", group=grp_show)
show_rsi_div    = input.bool(true, "Phân kỳ RSI", group=grp_show)
show_table      = input.bool(true, "Bảng số liệu góc phải", group=grp_show)

grp_fp = "Footprint & Delta"
ticks_per_row     = input.int(10, "Ticks mỗi dòng (ticks_per_row)", minval=1, group=grp_fp, tooltip="Tham số bắt buộc của request.footprint(). Chỉ dùng fp.delta() (tổng cả nến) nên giá trị này không ảnh hưởng số liệu Delta/CVD.")
va_pct            = input.float(70.0, "Value Area (%)", minval=50.0, maxval=90.0, step=1.0, group=grp_fp)
imb_pct           = input.float(300.0, "Ngưỡng Imbalance (%)", minval=100.0, step=10.0, group=grp_fp)
lower_tf_fallback = input.string("1S", "Khung Thời Gian Dự Phòng (Lower TF)", group=grp_fp)

grp_pivot = "Pivot Phân Kỳ"
pv_left  = input.int(5, "Số nến trái của pivot", minval=1, group=grp_pivot)
pv_right = input.int(5, "Số nến phải của pivot (độ trễ xác nhận)", minval=1, group=grp_pivot)

grp_peak  = "Delta Peak"
peak_len  = input.int(50, "Chu kỳ độ lệch chuẩn Delta", minval=2, group=grp_peak)
peak_mult = input.float(2.0, "Ngưỡng (x độ lệch chuẩn)", minval=0.1, step=0.1, group=grp_peak)

grp_rsi = "RSI"
rsi_len = input.int(14, "Chu Kỳ RSI", minval=1, group=grp_rsi)
rsi_src = input.source(close, "Nguồn RSI", group=grp_rsi)

grp_ui   = "Giao Diện"
col_bull = input.color(color.rgb(0, 150, 110), "Màu tăng", group=grp_ui)
col_bear = input.color(color.rgb(200, 40, 40), "Màu giảm", group=grp_ui)

// ============================================================================
// 2. HÀM HỖ TRỢ
// ============================================================================
// format.volume luôn hiện 3 số lẻ, nên tự định dạng 2 số lẻ.
f_format_delta(float val) =>
    string res  = "0"
    float  av   = na(val) ? 0.0 : math.abs(val)
    string sign = (not na(val) and val < 0) ? "-" : ""
    if na(val)
        res := "0"
    else if av >= 1000000000
        res := sign + str.tostring(av / 1000000000, "#.##") + "B"
    else if av >= 1000000
        res := sign + str.tostring(av / 1000000, "#.##") + "M"
    else if av >= 1000
        res := sign + str.tostring(av / 1000, "#.##") + "K"
    else
        res := sign + str.tostring(av, "#")
    res

// Delta theo lower TF: nến LTF tăng cộng volume, nến LTF giảm trừ volume.
f_ltf_delta(array<float> c_arr, array<float> o_arr, array<float> v_arr) =>
    float total = 0.0
    for i = 0 to array.size(c_arr) - 1
        float c = array.get(c_arr, i)
        float o = array.get(o_arr, i)
        float v = array.get(v_arr, i)
        if c > o
            total += v
        else if c < o
            total -= v
    total

// Ghi 1 dòng của bảng; dòng tắt thì xoá nội dung để không còn số cũ.
f_tbl_row(table t, int row, string name, string val, bool on) =>
    table.cell(t, 0, row, on ? name : "", text_color=color.white, text_size=size.small)
    table.cell(t, 1, row, on ? val : "", text_color=color.white, text_size=size.small)

// ============================================================================
// 3. RF (ROTATION FACTOR) THEO PHIÊN
// ============================================================================
bool is_new_session = timeframe.change("D")

// RF của từng nến: +1 cho mỗi high/low tăng so với nến trước, -1 cho mỗi cái giảm.
int bar_rf = 0
if high > high[1]
    bar_rf := bar_rf + 1
else if high < high[1]
    bar_rf := bar_rf - 1
if low > low[1]
    bar_rf := bar_rf + 1
else if low < low[1]
    bar_rf := bar_rf - 1

var int rf_session = 0
rf_session := is_new_session ? 0 : rf_session + bar_rf

// ============================================================================
// 4. DELTA / CVD — 3 TẦNG FALLBACK
// ============================================================================
bool need_delta = show_cvd_div or show_delta_peak or show_table

float  delta        = na
string delta_source = na
var float cvd = 0.0
float rng = high - low

footprint        fp       = na
array<float>     ltf_close = array.new<float>()
array<float>     ltf_open  = array.new<float>()
array<float>     ltf_vol   = array.new<float>()

if need_delta
    fp        := request.footprint(ticks_per_row, va_pct, imb_pct)
    ltf_close := request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, close, ignore_invalid_timeframe=true)
    ltf_open  := request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, open, ignore_invalid_timeframe=true)
    ltf_vol   := request.security_lower_tf(syminfo.tickerid, lower_tf_fallback, volume, ignore_invalid_timeframe=true)

    if not na(fp) and not na(fp.delta())
        delta        := fp.delta()
        delta_source := "Footprint"
    else if array.size(ltf_close) > 0
        delta        := f_ltf_delta(ltf_close, ltf_open, ltf_vol)
        delta_source := "LowerTF"
    else
        delta        := rng > 0 ? volume * ((close - low) - (high - close)) / rng : 0.0
        delta_source := "OHLCV-Approx"

    // Pine rollback biến var trước mỗi tick realtime nên không bị cộng trùng.
    cvd := is_new_session ? nz(delta) : cvd + nz(delta)

string delta_tag = delta_source == "Footprint" ? "F" : delta_source == "LowerTF" ? "L" : "A"

// ============================================================================
// 5. DELTA PEAK
// ============================================================================
// Peak = Delta vượt peak_mult lần độ lệch chuẩn của Delta trong peak_len nến.
float delta_sd  = ta.stdev(nz(delta), peak_len)
bool  peak_bull = show_delta_peak and not na(delta) and delta_sd > 0 and delta >= peak_mult * delta_sd
bool  peak_bear = show_delta_peak and not na(delta) and delta_sd > 0 and delta <= -peak_mult * delta_sd

if peak_bull
    label.new(bar_index, low, "Δ " + f_format_delta(delta), style=label.style_label_up, color=col_bull, textcolor=color.white, size=size.tiny)
if peak_bear
    label.new(bar_index, high, "Δ " + f_format_delta(delta), style=label.style_label_down, color=col_bear, textcolor=color.white, size=size.tiny)

// ============================================================================
// 6. PHÂN KỲ CVD & RSI (theo pivot)
// ============================================================================
// Pivot được xác nhận sau pv_right nến nên giá, CVD, RSI lấy tại bar pivot (offset pv_right).
float ph = ta.pivothigh(high, pv_left, pv_right)
float pl = ta.pivotlow(low, pv_left, pv_right)
float rsi_val = ta.rsi(rsi_src, rsi_len)
float cvd_ph = cvd[pv_right]
float cvd_pl = cvd[pv_right]
float rsi_ph = rsi_val[pv_right]
float rsi_pl = rsi_val[pv_right]
int   ph_bar = bar_index - pv_right
int   pl_bar = bar_index - pv_right

// Trạng thái pivot trước đó (cập nhật ở cuối phần này).
var float last_ph_price = na
var float last_ph_cvd   = na
var float last_ph_rsi   = na
var int   last_ph_bar   = na
var float last_pl_price = na
var float last_pl_cvd   = na
var float last_pl_rsi   = na
var int   last_pl_bar   = na

// Đỉnh giá cao hơn nhưng CVD/RSI thấp hơn: phân kỳ giảm. Đáy giá thấp hơn nhưng CVD/RSI cao hơn: phân kỳ tăng.
bool bear_cvd = show_cvd_div and not na(ph) and not na(last_ph_price) and ph > last_ph_price and cvd_ph < last_ph_cvd
bool bull_cvd = show_cvd_div and not na(pl) and not na(last_pl_price) and pl < last_pl_price and cvd_pl > last_pl_cvd
bool bear_rsi = show_rsi_div and not na(ph) and not na(last_ph_price) and ph > last_ph_price and rsi_ph < last_ph_rsi
bool bull_rsi = show_rsi_div and not na(pl) and not na(last_pl_price) and pl < last_pl_price and rsi_pl > last_pl_rsi

string bear_tags = str.trim((bear_cvd ? "CVD " : "") + (bear_rsi ? "RSI" : ""))
string bull_tags = str.trim((bull_cvd ? "CVD " : "") + (bull_rsi ? "RSI" : ""))

if bear_tags != ""
    line.new(last_ph_bar, last_ph_price, ph_bar, ph, xloc=xloc.bar_index, color=col_bear, style=line.style_dashed)
    label.new(ph_bar, ph, "PK▼ " + bear_tags, style=label.style_label_down, color=col_bear, textcolor=color.white, size=size.tiny)
if bull_tags != ""
    line.new(last_pl_bar, last_pl_price, pl_bar, pl, xloc=xloc.bar_index, color=col_bull, style=line.style_dashed)
    label.new(pl_bar, pl, "PK▲ " + bull_tags, style=label.style_label_up, color=col_bull, textcolor=color.white, size=size.tiny)

if not na(ph)
    last_ph_price := ph
    last_ph_cvd   := cvd_ph
    last_ph_rsi   := rsi_ph
    last_ph_bar   := ph_bar
if not na(pl)
    last_pl_price := pl
    last_pl_cvd   := cvd_pl
    last_pl_rsi   := rsi_pl
    last_pl_bar   := pl_bar

// ============================================================================
// 7. RF MẠNH — chấm dưới nến khi cả high và low cùng tăng (+2) hoặc cùng giảm (-2)
// ============================================================================
plotshape(show_rf_marks and bar_rf == 2 ? low : na, title="RF Mạnh Tăng", style=shape.circle, location=location.belowbar, color=col_bull, size=size.tiny)
plotshape(show_rf_marks and bar_rf == -2 ? high : na, title="RF Mạnh Giảm", style=shape.circle, location=location.abovebar, color=col_bear, size=size.tiny)

// ============================================================================
// 8. BẢNG SỐ LIỆU
// ============================================================================
var table tbl = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if show_table and barstate.islast
    table.cell(tbl, 0, 0, "Chỉ số", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "Giá trị", text_color=color.white, text_size=size.small)
    f_tbl_row(tbl, 1, "Delta (" + delta_tag + ")", f_format_delta(delta), show_delta_peak)
    f_tbl_row(tbl, 2, "CVD", f_format_delta(cvd), show_cvd_div)
    f_tbl_row(tbl, 3, "RF phiên", str.tostring(rf_session), show_rf_marks)
    f_tbl_row(tbl, 4, "RSI", na(rsi_val) ? "—" : str.tostring(rsi_val, "#.#"), show_rsi_div)
