//@version=6
// Order Flow Bar — Phân Tích Lưu Lượng Khối Lượng Giao Dịch
// Hiển Thị Cơ Cấu Order Flow (Buyer/Seller Volume) qua các thanh giá,
// kết hợp Market Profile (VAH/POC/VAL), Wyckoff & SMC để nhận diện quyết tâm giao dịch.
//
// Phiên bản: 1.0

indicator(
    title="Order Flow Tổng",
    shorttitle="OF_BAR",
    overlay=true,
    max_lines_count=500,
    max_labels_count=500,
    max_boxes_count=500
)

// ===== PHẠM VI TÍNH =====
mode_calc = input.string(
    defval="Visible Chart",
    title="Chế độ Phạm Vi",
    options=["Visible Chart", "Session", "Last HL"],
    group="Phạm Vi Tính"
)

price_step = input.float(
    defval=1.0,
    title="Bước Giá (Price Step)",
    minval=0.01,
    group="Phạm Vi Tính"
)

vis_bars_n = input.int(
    defval=100,
    title="Số Bar Nhìn Thấy",
    minval=10,
    group="Phạm Vi Tính"
)

max_lookback_bars = input.int(
    defval=500,
    title="Max Lookback Bars",
    minval=1,
    group="Phạm Vi Tính"
)

// ===== SMC (Last HL) =====
pivot_length = input.int(
    defval=10,
    title="Pivot Length",
    minval=1,
    group="SMC (Last HL)"
)

seed_mode = input.string(
    defval="Pivot Seed",
    title="Seed Mode",
    options=["Pivot Seed", "Session Seed"],
    group="SMC (Last HL)"
)

// ===== HIỂN THỊ =====
anchor_offset_bars = input.int(
    defval=0,
    title="Offset Bar Gốc",
    minval=0,
    group="Hiển Thị"
)

wing_max_bars = input.int(
    defval=20,
    title="Max Độ Rộng Cánh (Bars)",
    minval=1,
    group="Hiển Thị"
)

buyer_color = input.color(
    defval=color.new(color.green, 50),
    title="Màu Buyer",
    group="Hiển Thị"
)

seller_color = input.color(
    defval=color.new(color.red, 50),
    title="Màu Seller",
    group="Hiển Thị"
)

poc_color = input.color(
    defval=color.blue,
    title="Màu POC",
    group="Hiển Thị"
)

peak_buy_color = input.color(
    defval=color.new(color.lime, 50),
    title="Màu Peak Buy",
    group="Hiển Thị"
)

peak_sell_color = input.color(
    defval=color.new(color.orange, 50),
    title="Màu Peak Sell",
    group="Hiển Thị"
)

show_value_labels = input.bool(
    defval=true,
    title="Hiển Thị Nhãn Giá Trị",
    group="Hiển Thị"
)

// ===== FOOTPRINT TẦNG 1 =====
// Gọi request.footprint() đúng 1 lần (giới hạn Pine), tham số cố định, không expose input.
// Tier 1 chỉ cần fp.rows() (danh sách volume_row theo giá) để bucket buy/sell ở Task 3.
footprint fp = request.footprint(ticks_per_row=1, va_percent=70, imbalance_percent=300)

// Cờ phát hiện có dữ liệu footprint hay không (tài khoản không có Premium/sàn không hỗ trợ
// tick data -> fp/fp.rows() sẽ na). Không raise lỗi, chỉ coi như "chưa có dữ liệu".
bool has_footprint_data = not na(fp) and not na(fp.rows()) and array.size(fp.rows()) > 0

// ===== BUCKET VOLUME THEO PRICE_STEP (TẦNG 2) =====
// Gộp các row footprint (mỗi row = 1 tick, do ticks_per_row=1 ở trên) vào từng hàng
// price_step. row_id = số nguyên tuyệt đối của bậc giá (không tương đối theo base động)
// để Task 4/5 dùng lại được trực tiếp, không cần biết base hiện tại.
// Field volume_row dùng: up_price()/buy_volume()/sell_volume() — đã xác nhận thực nghiệm
// qua mcp-tv-validate-pine-script (xem task-3-report.md), vì reference manual chính thức
// là SPA không fetch được nội dung chi tiết qua WebFetch.
f_bucket_bar_rows(footprint fp_, float step) =>
    array<int>   row_ids = array.new<int>()
    array<float> buys    = array.new<float>()
    array<float> sells   = array.new<float>()
    // Không gọi fp_.rows() khi fp_ còn na (vd bar 0 / chưa có dữ liệu) — gọi thẳng sẽ
    // gây runtime error "cannot be na". Dùng `and` short-circuit để chặn trước.
    if not na(fp_) and not na(fp_.rows())
        array<volume_row> rows_arr = fp_.rows()
        int n_rows = array.size(rows_arr)
        if n_rows > 0
            for i = 0 to n_rows - 1
                volume_row row          = array.get(rows_arr, i)
                float      row_price    = row.up_price()
                int        row_id       = int(math.floor(row_price / step))
                float      row_buy      = row.buy_volume()
                float      row_sell     = row.sell_volume()
                int        existing_idx = array.indexof(row_ids, row_id)
                if existing_idx >= 0
                    array.set(buys, existing_idx, array.get(buys, existing_idx) + row_buy)
                    array.set(sells, existing_idx, array.get(sells, existing_idx) + row_sell)
                else
                    array.push(row_ids, row_id)
                    array.push(buys, row_buy)
                    array.push(sells, row_sell)
    [row_ids, buys, sells]

// ===== CIRCULAR BUFFER LƯU BUCKET THEO BAR (TASK 4) =====
// Lưu lại kết quả bucket (row_ids/buys/sells) của từng bar đã đóng, giữ tối đa
// max_lookback_bars phần tử gần nhất. Task 7 dùng lại of_buffer để dựng lại profile.
type BarRowVol
    int          bar_idx
    array<int>   row_ids
    array<float> buys
    array<float> sells

var array<BarRowVol> of_buffer = array.new<BarRowVol>()

// Đẩy 1 phần tử mới vào buffer (push), loại phần tử cũ nhất (shift) nếu vượt cap.
// Không tự đọc barstate.isconfirmed ở đây — nơi gọi (bên dưới) chịu trách nhiệm chỉ
// gọi hàm này khi nến đã đóng hoàn toàn, để không ghi đè/lặp dữ liệu nhiều lần trong
// 1 nến đang hình thành (gây sai lệch khi dựng lại profile ở Task 7).
f_push_bar_buffer(array<BarRowVol> buf, int bar_idx, array<int> row_ids, array<float> buys, array<float> sells, int cap) =>
    BarRowVol item = BarRowVol.new(bar_idx, row_ids, buys, sells)
    array.push(buf, item)
    if array.size(buf) > cap
        array.shift(buf)

// ===== DEBUG TẠM (Task 3) — sẽ xoá ở Task 11 =====
[dbg_rows, dbg_buy, dbg_sell] = f_bucket_bar_rows(fp, price_step)

// Chỉ push vào buffer khi nến đã xác nhận đóng (barstate.isconfirmed == true).
// BẮT BUỘC: push khi nến chưa đóng sẽ ghi đè/lặp dữ liệu nhiều lần trong 1 nến đang
// hình thành -> sai lệch khi dựng lại profile ở Task 7 (repaint).
if barstate.isconfirmed
    f_push_bar_buffer(of_buffer, bar_index, dbg_rows, dbg_buy, dbg_sell, max_lookback_bars)

// ===== PLACEHOLDER PLOT =====
plot(na)
plot(has_footprint_data ? 1 : 0, title="DEBUG_has_fp")
plot(array.sum(dbg_buy) - array.sum(dbg_sell), title="DEBUG_bucket_delta")
plot(array.size(of_buffer), title="DEBUG_buffer_size")
// Lưu ý: fp.delta() cũng raise runtime error "cannot be na" nếu gọi trực tiếp khi fp còn na
// (vd bar 0 / chưa có dữ liệu) — giống fp.rows(). Thêm guard not na(fp) để script chạy được
// trên toàn bộ các bar thay vì crash ngay từ bar đầu (lệch nhẹ so với literal brief Step 2,
// ghi rõ trong task-3-report.md).
plot(not na(fp) and not na(fp.delta()) ? fp.delta() : na, title="DEBUG_fp_delta")
