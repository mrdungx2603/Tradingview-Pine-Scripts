//@version=6
// Big Aggressor Flow — Bubble Lệnh Mua/Bán Chủ Động Lớn Theo Footprint (kiểu Bookmap)
//
// Đọc footprint Tầng 1 (request.footprint, ticks_per_row=1) của từng nến. Mỗi mức giá trong nến có:
//   - buy_volume: khối lượng khớp theo lệnh mua chủ động (ăn ask)
//   - sell_volume: khối lượng khớp theo lệnh bán chủ động (đập bid)
// Mức giá nào có khối lượng chủ động >= large_mult lần trung bình 1 mức giá (tính trên baseline_len
// nến gần nhất) được vẽ 1 bubble tròn có tâm đúng tại mức giá đó:
//   - Màu xanh: mua chủ động lớn. Màu đỏ: bán chủ động lớn.
//   - Bán kính tỷ lệ tuyến tính với khối lượng: bán kính = radius_scale * (khối lượng / ngưỡng),
//     giới hạn bởi max_radius. Bubble vẽ bằng polyline (đường tròn nhiều đỉnh).
//   - Số khối lượng hiện giữa bubble, neo đúng tại tâm (cùng mức giá).
// Bubble chỉ vẽ khi nến đã đóng (barstate.isconfirmed) nên không nhấp nháy khi giá đang chạy.
//
// Giới hạn:
//   - Trục ngang là bar, không phải pixel hay giây. Bán kính ngang làm tròn tới 1 bar nên kích thước
//     tăng theo bậc bar, không mịn từng đơn vị khối lượng.
//   - Trục dọc quy đổi từ ATR(14) theo vert_ratio. Đây là ước lượng, cần chỉnh vert_ratio cho đến khi
//     bubble tròn trên màn hình của bạn.
//   - TradingView không có sổ lệnh hay lệnh khớp riêng lẻ. Bubble là khối lượng chủ động tổng hợp
//     tại 1 mức giá trong 1 nến.
//
// Chỉ dùng footprint Tầng 1 — symbol/tài khoản không hỗ trợ tick data sẽ KHÔNG vẽ gì.
//
// Phiên bản: 1.2
// Thay đổi v1.2: Bubble đổi từ label.style_circle (4 bậc cố định) sang polyline hình tròn, bán kính
//        tuyến tính theo khối lượng. Tâm bubble neo đúng mức giá. Số khối lượng vẫn hiện bằng label
//        neo tại cùng tâm. Thêm Bán Kính Tối Đa, Hệ Số Bán Kính, Tỷ Lệ Trục Dọc.

indicator(
    title="Big Aggressor Flow",
    shorttitle="BAF",
    overlay=true,
    max_labels_count=500,
    max_polylines_count=100
)

// ===== CẤU HÌNH =====
grp_cfg = "Cấu Hình"

price_step = input.float(
    defval=1.0,
    title="Bước Giá (Price Step)",
    minval=0.01,
    group=grp_cfg,
    tooltip="Độ rộng 1 hàng giá. Nên khớp tick size của mã đang xem."
)

baseline_len = input.int(
    defval=50,
    title="Số Nến Nền So Sánh",
    minval=5,
    group=grp_cfg,
    tooltip="Khối lượng trung bình 1 mức giá được tính trên số nến này."
)

large_mult = input.float(
    defval=3.0,
    title="Hệ Số Lệnh Lớn (x TB mức giá)",
    minval=1.0,
    step=0.5,
    group=grp_cfg,
    tooltip="Mức giá có khối lượng chủ động >= hệ số này lần trung bình được vẽ bubble."
)

min_big_vol = input.float(
    defval=0.0,
    title="Khối Lượng Tối Thiểu",
    minval=0.0,
    group=grp_cfg,
    tooltip="Ngưỡng tuyệt đối. Bubble phải có khối lượng vượt cả ngưỡng này."
)

// ===== HIỂN THỊ =====
grp_draw = "Hiển Thị"

show_bubbles = input.bool(defval=true, title="Vẽ Bubble", group=grp_draw)

draw_bars = input.int(
    defval=200,
    title="Số Nến Gần Nhất Vẽ Bubble",
    minval=1,
    maxval=5000,
    group=grp_draw
)

radius_scale = input.float(
    defval=2.0,
    title="Bán Kính (bar) Tại 1x Ngưỡng",
    minval=0.1,
    step=0.5,
    group=grp_draw,
    tooltip="Bán kính ngang (đơn vị bar) của bubble có khối lượng đúng bằng ngưỡng lệnh lớn. Bubble gấp N lần ngưỡng có bán kính = N x giá trị này."
)

max_radius = input.float(
    defval=10.0,
    title="Bán Kính Tối Đa (bar)",
    minval=1.0,
    group=grp_draw,
    tooltip="Chặn bán kính để bubble rất lớn không che chart. Trên mức này, kích thước không còn tuyến tính."
)

vert_ratio = input.float(
    defval=0.25,
    title="Tỷ Lệ Trục Dọc (ry/rx)",
    minval=0.01,
    step=0.05,
    group=grp_draw,
    tooltip="Quy đổi bán kính dọc (theo giá) từ bán kính ngang (theo bar) qua ATR(14). Chỉnh cho đến khi bubble tròn trên màn hình của bạn."
)

show_markers = input.bool(defval=true, title="Hiện Tam Giác Đánh Dấu Nến", group=grp_draw)

col_buy  = input.color(defval=color.new(color.green, 0), title="Màu Mua Chủ Động", group=grp_draw)
col_sell = input.color(defval=color.new(color.red, 0), title="Màu Bán Chủ Động", group=grp_draw)

// ===== HẰNG & ATR (GLOBAL SCOPE) =====
int   N_SEG   = 24
float atr_val = ta.atr(14)

// ===== HÀM: ĐỈNH ĐƯỜNG TRÒN CHO POLYLINE =====
// Tâm (cx bar, cy giá), bán kính ngang rx (bar), bán kính dọc ry (giá).
f_circle_pts(int cx, float cy, int rx, float ry, int n) =>
    array<chart.point> pts = array.new<chart.point>()
    for k = 0 to n - 1
        float ang = 2.0 * math.pi * k / n
        int   px  = cx + int(math.round(rx * math.cos(ang)))
        float py  = cy + ry * math.sin(ang)
        array.push(pts, chart.point.from_index(px, py))
    pts

// ===== FOOTPRINT TẦNG 1 =====
// request.footprint() chỉ gọi 1 lần/script, đặt ở scope toàn cục.
footprint fp = request.footprint(ticks_per_row=1, va_percent=70, imbalance_percent=300)

bool has_fp = not na(fp) and not na(fp.rows()) and array.size(fp.rows()) > 0

// ===== LƯỢT 1: TỔNG KHỐI LƯỢNG VÀ SỐ MỨC GIÁ CỦA NẾN =====
float bar_total = 0.0
int   bar_rows  = 0

if has_fp
    array<volume_row> rows_pass1 = fp.rows()
    bar_rows := array.size(rows_pass1)
    for i = 0 to bar_rows - 1
        volume_row row_p1 = array.get(rows_pass1, i)
        bar_total := bar_total + row_p1.buy_volume() + row_p1.sell_volume()

// Trung bình khối lượng 1 mức giá, làm nền so sánh. ta.sma phải gọi ở scope toàn cục.
float bar_avg_row = bar_rows > 0 ? bar_total / bar_rows : 0.0
float baseline    = ta.sma(bar_avg_row, baseline_len)
float large_thr   = math.max(min_big_vol, large_mult * nz(baseline))
bool  can_flag    = has_fp and not na(baseline)

// ===== LƯỢT 2: ĐÁNH DẤU MỨC GIÁ CHỦ ĐỘNG LỚN, VẼ BUBBLE =====
int   big_buy_n    = 0
int   big_sell_n   = 0
float big_buy_vol  = 0.0
float big_sell_vol = 0.0

if can_flag
    array<volume_row> rows_pass2 = fp.rows()
    int n_rows2 = array.size(rows_pass2)
    for i = 0 to n_rows2 - 1
        volume_row row         = array.get(rows_pass2, i)
        float      row_buy     = row.buy_volume()
        float      row_sell    = row.sell_volume()
        float      row_px      = row.up_price()
        float      row_lo      = math.floor(row_px / price_step) * price_step
        float      row_mid     = row_lo + price_step / 2.0
        bool       is_big_buy  = row_buy > 0 and row_buy >= large_thr
        bool       is_big_sell = row_sell > 0 and row_sell >= large_thr
        bool       is_big      = is_big_buy or is_big_sell
        float      row_vol     = is_big_buy ? row_buy : row_sell
        color      cell_col    = is_big_buy ? col_buy : col_sell
        // Bán kính tuyến tính theo khối lượng / ngưỡng, giới hạn bởi max_radius. Khai báo ở scope for.
        float      ratio       = row_vol / math.max(large_thr, 1e-9)
        float      rx_raw      = math.min(max_radius, radius_scale * ratio)
        int        rx_int      = math.max(1, int(math.round(rx_raw)))
        float      ry_px       = rx_int * atr_val * vert_ratio
        string     bub_text    = str.tostring(math.round(row_vol))
        bool       draw_here   = show_bubbles and barstate.isconfirmed and bar_index >= last_bar_index - draw_bars

        big_buy_n    := big_buy_n + (is_big_buy ? 1 : 0)
        big_sell_n   := big_sell_n + (is_big_sell ? 1 : 0)
        big_buy_vol  := big_buy_vol + (is_big_buy ? row_buy : 0.0)
        big_sell_vol := big_sell_vol + (is_big_sell ? row_sell : 0.0)

        if draw_here and is_big
            polyline.new(
                f_circle_pts(bar_index, row_mid, rx_int, ry_px, N_SEG),
                curved=false, closed=true,
                line_color=color.new(cell_col, 0),
                fill_color=color.new(cell_col, 70),
                line_width=1
            )
            label.new(
                bar_index, row_mid, text=bub_text,
                style=label.style_none, size=size.tiny,
                textcolor=color.white,
                tooltip="Khối lượng chủ động: " + bub_text + " tại " + str.tostring(row_mid)
            )

// ===== ĐÁNH DẤU & CẢNH BÁO (CHỈ NẾN ĐÃ ĐÓNG) =====
bool buy_flag  = big_buy_n > 0 and barstate.isconfirmed
bool sell_flag = big_sell_n > 0 and barstate.isconfirmed

plotshape(
    show_markers and buy_flag,
    title="Lệnh Mua Lớn",
    style=shape.triangleup,
    location=location.belowbar,
    color=col_buy,
    size=size.small
)

plotshape(
    show_markers and sell_flag,
    title="Lệnh Bán Lớn",
    style=shape.triangledown,
    location=location.abovebar,
    color=col_sell,
    size=size.small
)

alertcondition(buy_flag, title="Lệnh Mua Chủ Động Lớn", message="Big Aggressor Flow: có mức giá mua chủ động lớn trong nến vừa đóng")
alertcondition(sell_flag, title="Lệnh Bán Chủ Động Lớn", message="Big Aggressor Flow: có mức giá bán chủ động lớn trong nến vừa đóng")
